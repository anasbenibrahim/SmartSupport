pipeline {
    agent any

    stages {

        stage('Install Dependencies') {
            steps {
                dir('client') {
                    sh '''
                        echo "Node version:"
                        node --version

                        echo "NPM version:"
                        npm --version

                        echo "Installing dependencies..."
                        npm install
                    '''
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('client') {
                    sh '''
                        echo "Building React application..."
                        npm run build
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Frontend React construit avec succès'
        }

        failure {
            echo 'Erreur dans le pipeline Frontend'
        }
    }
}
