pipeline {
    agent any

    stages {
        stage('Install Dependencies') {
            steps {
                dir('client') {
                    sh '''
                        npm install
                    '''
                }
            }
        }

        stage('Test Frontend') {
            steps {
                dir('client') {
                    sh '''
                        npm test -- --watchAll=false
                    '''
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('client') {
                    sh '''
                        npm run build
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Frontend React construit avec succès'
        }

        failure {
            echo 'Erreur dans le pipeline Frontend'
        }
    }
}
