pipeline {
    agent any

    stages {

        stage('Build Backend') {
            steps {
                echo 'Build des microservices Spring Boot'

                sh '''
                    set -e

                    for service in \
                        discovery-service \
                        config-server \
                        api-gateway \
                        auth-service \
                        user-service \
                        ticket-service \
                        notification-service
                    do
                        echo "=============================="
                        echo "Building $service"
                        echo "=============================="

                        cd "$service"

                        mvn clean package -DskipTests

                        cd ..
                    done
                '''
            }
        }

        stage('Tests Backend') {
            steps {
                echo 'Tests unitaires Spring Boot'

                sh '''
                    set -e

                    for service in \
                        discovery-service \
                        config-server \
                        api-gateway \
                        auth-service \
                        user-service \
                        ticket-service \
                        notification-service
                    do
                        echo "=============================="
                        echo "Testing $service"
                        echo "=============================="

                        cd "$service"

                        mvn test

                        cd ..
                    done
                '''
            }
        }

        stage('Sonar') {
            steps {
                echo 'Sonar Spring Boot'

                sh '''
                    set -e

                    mvn clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                    -Dsonar.projectKey=smart_support \
                    -Dsonar.projectName='smart_support' \
                    -Dsonar.host.url=http://localhost:9000 \
                    -Dsonar.token=sqp_a234a8429ca5ef11d33c1f9638489be08fd7e0cb

                        cd ..
                    done
                '''
            }
        }

    }

    post {
        success {
            echo 'Backend pipeline terminé avec succès'
        }

        failure {
            echo 'Erreur dans le pipeline Backend'
        }
    }
}
