pipeline {
    agent any

    stages {

        stage('Build Backend') {
            steps {
                echo 'Build des microservices Spring Boot'

                sh '''
                    set -e

                    for service in \
                        discovery-service \
                        config-server \
                        api-gateway \
                        auth-service \
                        user-service \
                        ticket-service \
                        notification-service
                    do
                        echo "=============================="
                        echo "Building $service"
                        echo "=============================="

                        cd "$service"

                        mvn clean package -DskipTests

                        cd ..
                    done
                '''
            }
        }

        stage('Tests Backend') {
            steps {
                echo 'Tests unitaires Spring Boot'

                sh '''
                    set -e

                    for service in \
                        discovery-service \
                        config-server \
                        api-gateway \
                        auth-service \
                        user-service \
                        ticket-service \
                        notification-service
                    do
                        echo "=============================="
                        echo "Testing $service"
                        echo "=============================="

                        cd "$service"

                        mvn test

                        cd ..
                    done
                '''
            }
        }
    }

    post {
        success {
            echo 'Backend pipeline terminé avec succès'
        }

        failure {
            echo 'Erreur dans le pipeline Backend'
        }
    }
}
