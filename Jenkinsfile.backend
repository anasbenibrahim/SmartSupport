pipeline {
    agent any

    environment {
        SONAR_HOST_URL = 'http://sonarqube:9000'
        SERVICES = 'discovery-service config-server api-gateway auth-service user-service ticket-service notification-service'
    }

    stages {

        stage('Build Backend') {
            steps {
                echo 'Build des microservices Spring Boot'

                sh '''
                    set -e

                    for service in $SERVICES
                    do
                        echo "=============================="
                        echo "Building $service"
                        echo "=============================="

                        cd "$service"
                        mvn clean package -DskipTests
                        cd ..
                    done
                '''
            }
        }

        stage('Tests Backend') {
            steps {
                echo 'Tests unitaires Spring Boot'

                sh '''
                    set -e

                    for service in $SERVICES
                    do
                        echo "=============================="
                        echo "Testing $service"
                        echo "=============================="

                        cd "$service"
                        mvn test
                        cd ..
                    done
                '''
            }
        }

        stage('Sonar') {
            steps {
                echo 'Analyse SonarQube des microservices Spring Boot'

                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        set -e

                        for service in $SERVICES
                        do
                            echo "=============================="
                            echo "Sonar analysis: $service"
                            echo "=============================="

                            cd "$service"

                            mvn clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                                -Dsonar.projectKey=smart_support_${service} \
                                -Dsonar.projectName="smart_support - ${service}" \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.token=${SONAR_TOKEN}

                            cd ..
                        done
                    '''
                }
            }
        }

    }

    post {
        success {
            echo 'Backend pipeline terminé avec succès'
        }

        failure {
            echo 'Erreur dans le pipeline Backend'
        }
    }
}
